<%@ page pageEncoding="UTF-8" %>
<%@ include file="WEB-INF/jspf/header.jspf" %>
<div class="page-heading"><div><div class="eyebrow">NHẬP PHỤ TÙNG / PHỤ TÙNG MỚI</div><h1>Thêm phụ tùng mới</h1><p>Khai báo thông tin phụ tùng trước khi thêm vào hóa đơn nhập.</p></div></div>
<%@ include file="WEB-INF/jspf/steps.jspf" %>
<section class="panel form-panel"><div class="panel-head"><h2>Thông tin phụ tùng</h2><span class="summary-label"><span class="required">*</span> Thông tin bắt buộc</span></div><div class="panel-body"><form id="part-form"><div class="form-grid">
<div class="field full-width"><label for="ten">Tên phụ tùng <span class="required">*</span></label><input id="ten" name="ten" required maxlength="255" placeholder="Nhập tên phụ tùng"></div>
<div class="field"><label for="nhom">Nhóm phụ tùng <span class="required">*</span></label><select id="nhom" name="nhom" required><option value="">Chọn nhóm phụ tùng</option><option value="1">Phụ tùng động cơ</option><option value="2">Hệ thống phanh</option><option value="3">Dầu &amp; dung dịch</option><option value="4">Hệ thống điện</option></select></div>
<div class="field"><label for="donVi">Đơn vị tính <span class="required">*</span></label><select id="donVi" name="donVi" required><option value="">Chọn đơn vị tính</option><option>Cái</option><option>Chiếc</option><option>Bộ</option><option>Lít</option></select></div>
<div class="field"><label for="hangSanXuat">Hãng sản xuất <span class="required">*</span></label><input id="hangSanXuat" name="hangSanXuat" required maxlength="255" placeholder="Nhập hãng sản xuất"></div>
<div class="field"><label for="giaBan">Giá bán (VNĐ)</label><input id="giaBan" name="giaBan" type="number" min="0" step="0.01" max="999999999999" placeholder="Chưa cập nhật"><small>Bắt buộc khi công bố; khác với đơn giá nhập trên hóa đơn.</small></div>
<div class="field"><label for="thongSo">Thông số kỹ thuật</label><input id="thongSo" name="thongSo" maxlength="255" placeholder="Mã tham chiếu, kích thước, tiêu chuẩn..."></div>
<div class="field"><label for="dongXePhuHop">Dòng xe phù hợp</label><input id="dongXePhuHop" name="dongXePhuHop" maxlength="255" placeholder="Hãng xe, dòng xe, đời xe"></div>
<div class="field"><label for="hanBaoHanh">Thời hạn bảo hành</label><input id="hanBaoHanh" name="hanBaoHanh" maxlength="100" placeholder="Ví dụ: 03 tháng"></div>
<div class="field"><label for="trangThai">Trạng thái</label><select id="trangThai" name="trangThai"><option>Chưa công bố</option><option>Đang kinh doanh</option></select><small>Chỉ công bố khi đã có mô tả và giá bán.</small></div>
<div class="field full-width"><label for="dieuKienBaoHanh">Điều kiện bảo hành</label><textarea id="dieuKienBaoHanh" name="dieuKienBaoHanh" maxlength="255" placeholder="Phạm vi và điều kiện áp dụng bảo hành"></textarea></div>
<div class="field full-width"><label for="moTa">Mô tả</label><textarea id="moTa" name="moTa" maxlength="255" placeholder="Mô tả phụ tùng"></textarea></div>
<div class="field"><label for="tonKho">Tồn kho ban đầu</label><input id="tonKho" type="number" value="0" readonly><small>Chỉ tăng sau khi xác nhận hóa đơn nhập.</small></div><div class="field full-width"><label for="hinhAnh">Ảnh minh họa</label><select id="hinhAnh" name="hinhAnh"><option value="">Chưa có ảnh</option><option value="assets/part.svg">Minh họa phụ tùng</option><option value="assets/brake.svg">Minh họa hệ thống phanh</option></select><small>Chọn ảnh minh họa có sẵn.</small><img id="upload-preview" class="illustration" alt="Ảnh minh họa phụ tùng" hidden></div>
</div><p class="error" id="part-form-error" role="alert" hidden></p><div class="actions"><a class="btn left" href="gdNhapPhuTung4.jsp">← Quay lại</a><button class="btn btn-primary" type="submit">Lưu phụ tùng →</button></div></form></div><div class="panel-note">Lưu xong quay lại màn hình lập hóa đơn để chọn phụ tùng vừa thêm, sau đó nhập số lượng và đơn giá nhập.</div></section>
