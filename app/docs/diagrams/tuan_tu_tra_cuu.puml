@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 14
skinparam sequenceMessageAlign center
skinparam maxMessageSize 240
skinparam ParticipantPadding 16
skinparam responseMessageBelowArrow true
hide footbox

title Biểu đồ tuần tự thiết kế modul tìm kiếm thông tin dịch vụ/phụ tùng
actor "Khách hàng" as A
boundary "customerHome.jsp" as Home
boundary "catalogSearch.jsp" as Search
boundary "itemDetails.jsp" as Detail
control ": CatalogServlet4" as C
control ": ServiceDAO4" as SD
control ": SparePartDAO4" as PD
entity ": Service4" as S
entity ": SparePart4" as P

A -> Home : 1: click tìm thông tin
Home -> C : 2: showSearch(request, response)
activate C
C -> Search : 3: gọi
activate Search
deactivate C
Search --> A : 4: hiển thị
deactivate Search
A -> Search : 5: nhập lọc; click Tìm kiếm
Search -> C : 6: searchCatalog(request, response)
activate C
C -> SD : 7: gọi
activate SD
SD -> SD : 8: findServicesByName("lọc")
activate SD
SD -> S : 9: gọi
activate S
S -> S : 10: Service4()
activate S
deactivate S
S --> SD : 11: trả về
deactivate S
SD --> C : 12: trả về
deactivate SD
deactivate SD
C -> PD : 13: gọi
activate PD
PD -> PD : 14: findSparePartsByName("lọc", true)
activate PD
PD -> P : 15: gọi
activate P
P -> P : 16: SparePart4()
activate P
deactivate P
P --> PD : 17: trả về
deactivate P
PD --> C : 18: trả về
deactivate PD
deactivate PD
C -> Search : 19: gọi
activate Search
deactivate C
Search --> A : 20: hiển thị
deactivate Search
A -> Search : 21: click chọn PT1
Search -> C : 22: viewDetails(request, response)
activate C
C -> PD : 23: gọi
activate PD
PD -> PD : 24: getSparePartDetails(sparePartId, true)
activate PD
PD -> P : 25: gọi
activate P
P -> P : 26: SparePart4()
activate P
deactivate P
P --> PD : 27: trả về
deactivate P
PD --> C : 28: trả về
deactivate PD
deactivate PD
C -> Detail : 29: gọi
activate Detail
deactivate C
Detail --> A : 30: hiển thị
deactivate Detail
A -> Detail : 31: click Quay lại
Detail -> C : 32: searchCatalog(request, response)
activate C
C -> SD : 33: gọi
activate SD
SD -> SD : 34: findServicesByName("lọc")
activate SD
SD -> S : 35: gọi
activate S
S -> S : 36: Service4()
activate S
deactivate S
S --> SD : 37: trả về
deactivate S
SD --> C : 38: trả về
deactivate SD
deactivate SD
C -> PD : 39: gọi
activate PD
PD -> PD : 40: findSparePartsByName("lọc", true)
activate PD
PD -> P : 41: gọi
activate P
P -> P : 42: SparePart4()
activate P
deactivate P
P --> PD : 43: trả về
deactivate P
PD --> C : 44: trả về
deactivate PD
deactivate PD
C -> Search : 45: gọi
activate Search
deactivate C
Search --> A : 46: hiển thị
deactivate Search
@enduml
