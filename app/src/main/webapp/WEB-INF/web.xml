<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>GaraMan</display-name>

    <!-- 1. EncodingFilter4 -->
    <filter>
        <filter-name>EncodingFilter4</filter-name>
        <filter-class>filter.EncodingFilter4</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter4</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
        <dispatcher>ERROR</dispatcher>
    </filter-mapping>

    <!-- 2. AuthFilter4 -->
    <filter>
        <filter-name>AuthFilter4</filter-name>
        <filter-class>filter.AuthFilter4</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter4</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
    </filter-mapping>

    <!-- Servlets -->
    <!-- AuthServlet4 -->
    <servlet>
        <servlet-name>AuthServlet4</servlet-name>
        <servlet-class>controller.AuthServlet4</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthServlet4</servlet-name>
        <url-pattern>/login</url-pattern>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- HomeServlet4 -->
    <servlet>
        <servlet-name>HomeServlet4</servlet-name>
        <servlet-class>controller.HomeServlet4</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeServlet4</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>

    <!-- CatalogServlet4 -->
    <servlet>
        <servlet-name>CatalogServlet4</servlet-name>
        <servlet-class>controller.CatalogServlet4</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CatalogServlet4</servlet-name>
        <url-pattern>/customer/catalog</url-pattern>
        <url-pattern>/customer/catalog/detail</url-pattern>
    </servlet-mapping>

    <!-- SupplierServlet4 -->
    <servlet>
        <servlet-name>SupplierServlet4</servlet-name>
        <servlet-class>controller.SupplierServlet4</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SupplierServlet4</servlet-name>
        <url-pattern>/warehouse/suppliers</url-pattern>
        <url-pattern>/warehouse/suppliers/new</url-pattern>
        <url-pattern>/warehouse/suppliers/create</url-pattern>
    </servlet-mapping>

    <!-- SparePartServlet4 -->
    <servlet>
        <servlet-name>SparePartServlet4</servlet-name>
        <servlet-class>controller.SparePartServlet4</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SparePartServlet4</servlet-name>
        <url-pattern>/warehouse/parts/new</url-pattern>
        <url-pattern>/warehouse/parts/create</url-pattern>
    </servlet-mapping>

    <!-- PurchaseInvoiceServlet4 -->
    <servlet>
        <servlet-name>PurchaseInvoiceServlet4</servlet-name>
        <servlet-class>controller.PurchaseInvoiceServlet4</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PurchaseInvoiceServlet4</servlet-name>
        <url-pattern>/warehouse/purchases/start</url-pattern>
        <url-pattern>/warehouse/purchases/draft</url-pattern>
        <url-pattern>/warehouse/purchases/search-part</url-pattern>
        <url-pattern>/warehouse/purchases/add-line</url-pattern>
        <url-pattern>/warehouse/purchases/update</url-pattern>
        <url-pattern>/warehouse/purchases/remove-line</url-pattern>
        <url-pattern>/warehouse/purchases/cancel</url-pattern>
        <url-pattern>/warehouse/purchases/confirm</url-pattern>
        <url-pattern>/warehouse/purchases/view</url-pattern>
        <url-pattern>/warehouse/purchases/print</url-pattern>
        <url-pattern>/warehouse/purchases/pay</url-pattern>
        <url-pattern>/warehouse/purchases/unpaid</url-pattern>
    </servlet-mapping>

    <!-- Session Configuration -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- Welcome File -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Error Pages -->
    <error-page>
        <error-code>400</error-code>
        <location>/WEB-INF/view/common/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/view/common/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/view/common/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>405</error-code>
        <location>/WEB-INF/view/common/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>409</error-code>
        <location>/WEB-INF/view/common/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/view/common/error.jsp</location>
    </error-page>

</web-app>
