<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<fmt:setLocale value="vi_VN" />

<section class="panel" id="parts-picker" style="margin-bottom: 24px;">
  <div class="panel-head" style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border); padding-bottom: 12px;">
    <h2 style="margin: 0; font-size: 18px;">Tìm và chọn phụ tùng</h2>
    <button type="submit" class="btn"
            formaction="<c:url value='/warehouse/purchases/update'/>"
            name="dichDen" value="new-part"
            style="font-size: 13px;">
      + Thêm phụ tùng mới
    </button>
  </div>

  <div class="panel-body" style="padding-top: 16px;">
    <div class="inline-search" style="display: flex; gap: 12px; align-items: flex-end;">
      <div class="field" style="flex: 1; margin: 0;">
        <label for="tuKhoa" style="display: block; font-weight: 500; margin-bottom: 6px;">Tên hoặc mã phụ tùng</label>
        <input id="tuKhoa" name="tuKhoa" class="form-control"
               maxlength="150" placeholder="Nhập tên hoặc mã phụ tùng, ví dụ: Lọc dầu, Phanh..."
               value="<c:out value='${tuKhoa}'/>">
      </div>
      <button class="btn btn-primary" type="submit" id="btn-search-parts"
              formaction="<c:url value='/warehouse/purchases/search-part'/>"
              style="padding: 10px 24px;">
        Tìm kiếm
      </button>
      <c:if test="${not empty tuKhoa}">
        <a class="btn" href="<c:url value='/warehouse/purchases/draft'><c:param name='maYeuCau' value='${maYeuCau}'/></c:url>" style="padding: 10px 16px;">
          Xóa tìm
        </a>
      </c:if>
    </div>

    <c:choose>
      <c:when test="${not empty dsPhuTungTimKiem}">
        <div style="margin-top: 20px;">
          <h3 style="font-size: 14px; margin-bottom: 10px; color: var(--muted);">
            Kết quả tìm thấy (<c:out value="${dsPhuTungTimKiem.size()}"/> phụ tùng):
          </h3>
          <div class="table-wrap">
            <table class="data-table">
              <thead>
                <tr>
                  <th style="width: 70px;">Mã</th>
                  <th>Tên phụ tùng</th>
                  <th>Hãng sản xuất</th>
                  <th>ĐVT</th>
                  <th>Tồn hiện tại</th>
                  <th>Trạng thái</th>
                  <th style="width: 90px; text-align: center;">Thao tác</th>
                </tr>
              </thead>
              <tbody>
                <c:forEach var="pt" items="${dsPhuTungTimKiem}">
                  <tr>
                    <td class="code">PT<c:out value="${pt.id}"/></td>
                    <td>
                      <strong><c:out value="${pt.ten}"/></strong>
                      <c:if test="${pt.nhom != null}">
                        <br><small style="color: var(--muted);"><c:out value="${pt.nhom.ten}"/></small>
                      </c:if>
                    </td>
                    <td><c:out value="${pt.hangSanXuat}"/></td>
                    <td><c:out value="${pt.donVi}"/></td>
                    <td><fmt:formatNumber value="${pt.tonKho}" maxFractionDigits="3"/> <c:out value="${pt.donVi}"/></td>
                    <td><span class="badge ${pt.trangThai == 'Đang kinh doanh' ? 'neutral' : 'warning'}"><c:out value="${pt.trangThai}"/></span></td>
                    <td style="text-align: center;">
                      <button type="submit" class="btn btn-small select-part"
                              formaction="<c:url value='/warehouse/purchases/add-line'/>"
                              name="selectedPartId" value="${pt.id}">
                        Chọn →
                      </button>
                    </td>
                  </tr>
                </c:forEach>
              </tbody>
            </table>
          </div>
        </div>
      </c:when>

      <c:when test="${not empty tuKhoa}">
        <div class="empty" style="margin-top: 16px;">
          <strong>Không tìm thấy phụ tùng phù hợp</strong>
          <p>Không có phụ tùng nào khớp với từ khóa "<strong><c:out value='${tuKhoa}'/></strong>". Thử tìm với từ khóa khác hoặc nhấn "<strong>+ Thêm phụ tùng mới</strong>" ở góc trên.</p>
        </div>
      </c:when>

      <c:otherwise>
        <p class="page-subtitle picker-result" style="color: var(--muted); font-size: 13px; margin-top: 12px;">
          Nhập tên phụ tùng và chọn <strong>Tìm kiếm</strong> để thêm dòng vào hóa đơn nhập.
        </p>
      </c:otherwise>
    </c:choose>
  </div>
</section>
