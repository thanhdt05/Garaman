<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>

<ol class="stepper" aria-label="Quy trình nhập phụ tùng">
  <li class="${buocNhap == 1 ? 'active' : (buocNhap > 1 ? 'done' : '')}">
    <span class="step-number">1</span>Chọn nhà cung cấp
  </li>
  <li class="${buocNhap == 2 ? 'active' : (buocNhap > 2 ? 'done' : '')}">
    <span class="step-number">2</span>Lập hóa đơn
  </li>
  <li class="${buocNhap == 3 ? 'active' : (buocNhap > 3 ? 'done' : '')}">
    <span class="step-number">3</span>Hóa đơn xác nhận
  </li>
  <li class="${buocNhap == 4 ? 'active' : (buocNhap > 4 ? 'done' : '')}">
    <span class="step-number">4</span>Bản in hóa đơn
  </li>
</ol>
